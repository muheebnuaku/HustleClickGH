// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String        @id @default(cuid())
  userId          String        @unique // Auto-generated user ID for login
  fullName        String
  email           String        @unique
  phone           String
  password        String
  image           String?       // Profile image URL or base64
  nationalId      String?       // Legacy plaintext national ID (superseded by idNumber). Kept for backward compat.
  // Identity verification (idNumber stored encrypted at rest — see lib/crypto.ts)
  idType          String?       // ghana_card | passport | voter_id | drivers_license | other
  idNumber        String?       // AES-256-GCM encrypted identity/ID card number
  idNumberLast4   String?       // Last few chars, plaintext, for masked display without decryption
  // Location (required for contributors — Ghana Data Protection Act: purpose-bound)
  country         String?
  region          String?
  city            String?
  // Verification (admin-granted badge shown next to the user's name)
  verified        Boolean       @default(false)
  verifiedAt      DateTime?
  // Set by an admin to prompt users who haven't provided their location
  locationRequested Boolean     @default(false)
  // Onboarding / consent
  profileCompleted Boolean      @default(false) // true once location + ID + consent captured
  consentSignedAt DateTime?     // when the data processing agreement was signed
  consentVersion  String?       // version of the agreement the user signed
  role            String        @default("user") // user, admin, or manager
  status          String        @default("active") // active, suspended
  balance         Float         @default(0)
  totalEarned     Float         @default(0)
  referralCode    String        @unique
  referredBy      String?
  // Managers earn a % commission when people they referred get rewarded on a
  // project. Null = use DEFAULT_MANAGER_COMMISSION. Only meaningful for role="manager".
  commissionPercent Float?
  // How many times a MANAGER may submit to the same project. Null = unlimited
  // (managers are exempt from the project's maxSubmissionsPerUser). Admin-set.
  managerSubmitLimit Int?
  personalCallCode String?      @unique // Permanent 5-char code for voice calls
  lastSeenAt      DateTime?     // heartbeat timestamp; "online" = within the last ~90s
  // AI-assisted multi-account / fraud detection (see lib/fraud-check.ts). Set
  // at registration when the signup looks like a duplicate of an existing
  // account (similar phone/email/location) but isn't an exact match — an
  // admin reviews and clears it via Verify/Suspend rather than it being
  // auto-blocked, since fuzzy signals can be false positives.
  fraudRiskScore  Int?          // 0-100, higher = more suspicious
  fraudRiskReason String?       // human-readable explanation from the AI/heuristic check
  fraudFlaggedAt  DateTime?
  suspectedDuplicateOfUserId String? // id of the existing account this one may duplicate
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  surveyResponses  SurveyResponse[]
  withdrawals      Withdrawal[]
  referrals        Referral[]       @relation("Referrer")
  referredUsers    Referral[]       @relation("Referred")
  dataSubmissions  DataSubmission[]
  callRecordings   CallRecording[]
  consentRecords   ConsentRecord[]
  webauthnCredentials WebAuthnCredential[]
  pushSubscriptions PushSubscription[]
}

// Browser push subscription (Web Push API). One row per device/browser that
// has granted notification permission.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String   // client public key
  auth      String   // client auth secret
  userAgent String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Biometric / passkey (WebAuthn) credentials — Face ID, Touch ID, Windows Hello,
// Android fingerprint. Each row is one enrolled authenticator for a user.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique          // base64url credential ID
  publicKey    Bytes                        // COSE public key
  counter      Int       @default(0)        // signature counter (clone detection)
  transports   String?                      // JSON array e.g. ["internal","hybrid"]
  deviceName   String?                      // friendly label
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Auditable record of consent to the Data Processing Agreement / Privacy Policy.
// One row per signing event so policy-version history is preserved (GDPR / Ghana DPA).
model ConsentRecord {
  id              String   @id @default(cuid())
  userId          String
  documentType    String   @default("data_processing_agreement") // data_processing_agreement | privacy_policy | terms
  documentVersion String   // e.g. "1.0"
  signedName      String   // typed full-name e-signature
  agreed          Boolean  @default(true)
  ipAddress       String?
  userAgent       String?
  signedAt        DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentType, documentVersion])
}

// Inbound partnership / project inquiries from companies & AI labs.
model PartnerInquiry {
  id           String   @id @default(cuid())
  companyName  String
  contactName  String
  workEmail    String
  phone        String?
  country      String?
  projectType  String   // image_dataset | voice | video | survey | language | other
  datasetSize  String?  // free-text range, e.g. "10k-50k images"
  budgetRange  String?
  message      String
  status       String   @default("new") // new | contacted | in_progress | closed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Survey {
  id                  String           @id @default(cuid())
  title               String
  description         String
  headerImage         String?          // Optional header image URL/base64 displayed at top of survey
  backgroundImage     String?          // Optional background image URL/base64 displayed behind survey form
  reward              Float            @default(0) // 0 for user surveys, > 0 for admin surveys
  maxRespondents      Int
  currentRespondents  Int              @default(0)
  visibility          String           @default("public")
  status              String           @default("active") // active, expired, paused
  surveyType          String           @default("admin") // admin or user
  shareCode           String?          @unique // Unique code for sharing user surveys
  expiresAt           DateTime
  createdBy           String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  
  // Relations
  questions           SurveyQuestion[]
  responses           SurveyResponse[]
}

model SurveyQuestion {
  id              String   @id @default(cuid())
  surveyId        String
  questionText    String
  questionType    String   // text, multiple-choice, rating, etc.
  options         String?  // JSON string for options
  required        Boolean  @default(true)
  order           Int
  createdAt       DateTime @default(now())
  
  // Relations
  survey          Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}

model SurveyResponse {
  id              String   @id @default(cuid())
  surveyId        String
  userId          String
  answers         String   // JSON string of answers
  rewarded        Boolean  @default(false)
  submittedAt     DateTime @default(now())
  
  // Relations
  survey          Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([surveyId, userId])
}

model Withdrawal {
  id              String   @id @default(cuid())
  userId          String
  amount          Float
  paymentMethod   String
  mobileNumber    String
  accountName     String
  status          String   @default("pending") // pending, approved, rejected
  requestedAt     DateTime @default(now())
  processedAt     DateTime?
  processedBy     String?
  notes           String?
  receiptUrl      String?  // payment receipt uploaded by admin, required to approve

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// A commission a manager earned because someone THEY referred was rewarded on a
// project. Scalar-id style (no relations) — keeps it decoupled like CallSession.
model ManagerCommission {
  id             String   @id @default(cuid())
  managerId      String   // the manager who gets paid
  referredUserId String   // the contributor whose approval triggered it
  submissionId   String
  projectId      String
  rewardAmount   Float    // the contributor's reward this was based on
  percent        Float    // rate applied at the time
  amount         Float    // commission credited to the manager
  createdAt      DateTime @default(now())

  @@index([managerId, createdAt])
  @@index([submissionId])
}

model Referral {
  id              String   @id @default(cuid())
  referrerId      String
  referredId      String
  earned          Float    @default(1.0)
  createdAt       DateTime @default(now())

  // Relations
  referrer        User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred        User     @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
}

model DataProject {
  id                 String           @id @default(cuid())
  title              String
  description        String
  projectType        String           // voice | video | face
  instructions       String           // step-by-step guide for users
  samplePrompts      String?          // JSON array of prompts/phrases to record
  sampleVideoUrl     String?          // Legacy single sample video URL (video projects); kept for back-compat
  sampleVideoUrls    String?          // JSON array of sample video URLs (video projects)
  reward             Float            // GH₵ per approved submission
  maxSubmissions        Int
  maxSubmissionsPerUser Int              @default(1)  // how many TIMES each user may submit
  maxFilesPerSubmission Int              @default(1)  // how many FILES a contributor may include in one submission
  currentSubmissions    Int              @default(0)
  status             String           @default("active") // active | paused | completed
  languages          String?          // JSON array e.g. ["English","Twi","Ga"]
  minDurationSecs    Int              @default(3)
  maxDurationSecs    Int              @default(60)
  maxFileSizeMB      Int              @default(25)
  acceptedFormats    String           // JSON array e.g. ["mp3","wav","m4a"]
  // Audio format specs (voice projects)
  audioSampleRate    Int?             // Hz: 16000, 44100, 48000
  audioChannels      Int?             // 1 = mono, 2 = stereo
  audioBitDepth      Int?             // 16 or 32
  recordingType      String?          // "single" | "conversation"
  // Gender quotas (optional)
  malesNeeded        Int?             // how many male submissions needed
  femalesNeeded      Int?             // how many female submissions needed
  malesApproved      Int              @default(0)
  femalesApproved    Int              @default(0)
  expiresAt          DateTime?
  createdBy          String           // admin userId (or org owner userId)
  // Organization funding / escrow. orgId null = admin/internal project (behaves as before).
  orgId              String?          // owning Organization id
  orgPrice           Float?           // buyer's price per approved item (org projects). Platform margin = orgPrice − reward.
  budget             Float            @default(0) // funded pool at the buyer price (orgPrice × target)
  spent              Float            @default(0) // buyer cost already drawn from budget (orgPrice per approval)
  license            String           @default("commercial_ai") // usage licence key (see lib/licenses.ts)
  usageTerms         String?          // optional extra buyer-specified usage terms
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  submissions        DataSubmission[]

  @@index([orgId])
}

// A buyer organization. Logs in as a User with role="organization"; this row
// holds company details + the funded wallet. Scalar ids, no back-relations.
model Organization {
  id            String   @id @default(cuid())
  ownerUserId   String   @unique // the User account that signs in for this org
  name          String
  workEmail     String
  phone         String?
  country       String?
  status        String   @default("active") // active | suspended
  walletBalance Float    @default(0) // funded, not-yet-allocated GH₵
  mustSetPassword Boolean @default(true) // true after provisioning; false once the org sets its own password
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerUserId])
}

// Erasure propagation (Ghana DPA / GDPR right to erasure). When a contributor
// deletes their data, their approved submissions to org projects vanish from the
// live tables — this tombstone survives so buyers who already downloaded a
// dataset can be told exactly which items to purge from their copy. Holds no PII.
model ErasureTombstone {
  id            String   @id @default(cuid())
  orgId         String
  projectId     String
  submissionRef String   // the (now-deleted) submission id
  fileHash      String?  // SHA-256 to match the row in an already-downloaded dataset
  reason        String   @default("account_deletion") // account_deletion | data_withdrawal
  withdrawnAt   DateTime @default(now())

  @@index([projectId, withdrawnAt])
  @@index([orgId])
}

// Money movements for an org: Paystack top-ups and project allocations.
model OrgTransaction {
  id          String   @id @default(cuid())
  orgId       String
  type        String   // fund | allocation | refund
  amount      Float    // GH₵ (positive)
  provider    String?  // "paystack" for funds
  providerRef String?  @unique // Paystack reference (idempotency)
  status      String   @default("pending") // pending | success | failed
  meta        String?  // JSON (e.g. projectId for allocations)
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt])
}

// Durable participation record. Written when a submission is DELETED (for space)
// so we never lose the fact that a contributor was on a project and their
// outcome/earnings. PII-light snapshot (denormalized code/name), no files.
model ContributionRecord {
  id           String    @id @default(cuid())
  userId       String
  userCode     String?   // USER#### for display
  userName     String?
  projectId    String
  projectTitle String?
  status       String    // status at archive time (approved | rejected | pending)
  reward       Float     @default(0) // GH₵ earned (approved only)
  fileCount    Int       @default(0)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  archivedAt   DateTime  @default(now())

  @@index([projectId, archivedAt])
  @@index([userId])
}

model DataSubmission {
  id              String      @id @default(cuid())
  projectId       String
  userId          String
  fileUrl         String      // Primary file URL (first file); mirrors files[0] for back-compat
  fileName        String
  fileType        String      // MIME type e.g. audio/mpeg
  fileSizeMB      Float
  fileHash        String?     // SHA-256 of the primary file (server-computed); duplicate-content detection
  files           String?     // JSON array of {url,name,type,sizeMB} — a submission can hold several files (one user's full set)
  aiReview        String?     // JSON {score,verdict,reasons,summary,model} — auto AI quality suggestion
  durationSecs    Float?
  language        String?
  promptUsed      String?     // Which prompt the user recorded
  gender          String?     // "male" | "female"
  consentGiven    Boolean     @default(false)
  consentGivenAt  DateTime?
  status          String      @default("pending") // pending | approved | rejected
  rewarded        Boolean     @default(false)
  notes           String?     // Admin rejection notes
  submittedAt     DateTime    @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?

  project         DataProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, userId])
  @@index([userId])
  @@index([projectId, gender, status])
  @@index([projectId, fileHash])
  @@index([userId, submittedAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  type        String   // login | logout | register | call_start | call_end | call_error | call_cancel | call_decline | submission | withdrawal_request | call_connecting | call_reconnecting
  userId      String?  // null for system events
  userName    String?
  severity    String   @default("info") // info | warning | error | success
  metadata    String?  // JSON blob with extra details
  ip          String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
}

// A single admin email broadcast (campaign). Recipients + per-person delivery
// status live in EmailRecipient so we can show who received it, who didn't, and
// resend to the failures. Scalar-id style (no relations), like CallSession.
model EmailBroadcast {
  id            String   @id @default(cuid())
  subject       String
  message       String
  target        String   // all | verified | unverified | no_location | country | custom
  country       String?
  createdById   String
  createdByName String?
  total         Int      @default(0)
  sentCount     Int      @default(0)
  failedCount   Int      @default(0)
  status        String   @default("sending") // sending | completed | partial | stopped
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
}

model EmailRecipient {
  id          String   @id @default(cuid())
  broadcastId String
  email       String
  fullName    String?
  status      String   @default("pending") // pending | sent | failed
  error       String?
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([broadcastId, status])
  @@index([broadcastId])
}

// Password reset. We store only a SHA-256 hash of the emailed token (never the
// raw token), with a short expiry. Scalar-id style, like CallSession.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model CallSession {
  id              String    @id @default(cuid())
  callCode        String    @unique  // short code shared between users — personal 5-char or generated
  projectId       String?   // null for standalone calls, set for data-project calls
  initiatorId     String    // user id (cuid) of caller
  targetUserCode  String?   // personal call code of the person being called (for dialer mode)
  receiverId      String?   // user id of person who joins
  offer           String?   // JSON: RTCSessionDescription (SDP offer)
  answer          String?   // JSON: RTCSessionDescription (SDP answer)
  initiatorIce    String    @default("[]") // JSON array of RTCIceCandidate from initiator
  receiverIce     String    @default("[]") // JSON array of RTCIceCandidate from receiver
  status          String    @default("waiting") // calling | waiting | active | completed | declined | missed
  callType        String    @default("audio")   // "audio" | "video"
  endedBy         String?   // user id of who ended the call (initiator or receiver)
  endedReason     String?   // reason for ending (user_hangup, remote_hangup, call_timeout, etc)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([targetUserCode, status])
  @@index([initiatorId, status])
}

model CallRecording {
  id                   String   @id @default(cuid())
  callCode             String
  userId               String         // Original recorder (owner of call)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  duration             Int      // seconds
  fileUrl              String
  fileSize             Int?     // bytes
  callType             String   @default("audio")
  otherName            String?
  callEndedBy          String?  // user ID of whoever ended the call (for auto-share)
  shareFromRecordingId String?  // FK to original recording if this was auto-shared
  sharedRecording      CallRecording? @relation("RecordingShare", fields: [shareFromRecordingId], references: [id], onDelete: SetNull)
  sharedTo             CallRecording[] @relation("RecordingShare")
  createdAt            DateTime @default(now())

  @@index([callCode])
  @@index([userId])
}

// ── Community & messaging ─────────────────────────────────────────────────────
// Scalar user IDs, no formal relations to User (same style as CallSession) —
// keeps the User model untouched; routes do manual user lookups.

// Asymmetric follow ("add friend" = follow). followerId follows followingId.
model Follow {
  id          String   @id @default(cuid())
  followerId  String   // the user doing the following
  followingId String   // the user being followed
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

// blockerId has blocked blockedId (blocked user can't DM the blocker).
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// 1:1 direct-message thread. userAId/userBId stored in canonical order
// (userAId < userBId) so (A,B) and (B,A) collapse to a single row.
model Conversation {
  id            String   @id @default(cuid())
  userAId       String
  userBId       String
  lastMessageAt DateTime @default(now())
  isAdmin       Boolean  @default(false) // admin↔user thread (badged in UI)
  createdAt     DateTime @default(now())

  messages      Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?    // when the (single, 1:1) recipient read it
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
